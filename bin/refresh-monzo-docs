#!/usr/bin/env ruby
# frozen_string_literal: true

# Refreshes the vendored copies of monzo/docs' source/includes/*.md files
# that this gem's fixtures depend on. Run manually, never in CI:
#
#   bin/refresh-monzo-docs
#
# After running, review the diff (`git diff spec/fixtures/monzo_docs`) before
# committing — an upstream change may require updating stub_* helpers or
# specs that rely on the affected examples.

require "net/http"
require "uri"
require "fileutils"

TRACKED_FILES = %w[
  _authentication.md
  _errors.md
  _accounts.md
  _balance.md
  _pots.md
  _transactions.md
  _pagination.md
  _feed_items.md
  _attachments.md
  _receipts.md
].freeze

BASE_URL = "https://raw.githubusercontent.com/monzo/docs/master/source/includes"
DEST_DIR = File.join(__dir__, "..", "spec", "fixtures", "monzo_docs")

FileUtils.mkdir_p(DEST_DIR)

TRACKED_FILES.each do |filename|
  latest = Net::HTTP.get(URI("#{BASE_URL}/#{filename}")).force_encoding(Encoding::UTF_8)
  dest = File.join(DEST_DIR, filename)
  previous = File.exist?(dest) ? File.read(dest, encoding: Encoding::UTF_8) : nil

  if previous == latest
    puts "unchanged: #{filename}"
  else
    File.write(dest, latest)
    puts "#{previous.nil? ? 'added' : 'updated'}: #{filename}"
  end
end
